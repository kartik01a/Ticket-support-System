# Copy to .env and fill in. Never commit the real .env file.
PORT=4000
# SQLite file path (created automatically, parent dir is created too)
DATABASE_PATH=./data/tickets.db
# Allowed browser origin(s) for CORS, comma separated
CORS_ORIGIN=http://localhost:3000

# OpenAI. Without a key the API still runs: every ticket gets the documented fallback (General / Medium).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Max time to wait for the AI before falling back (milliseconds)
AI_TIMEOUT_MS=8000
